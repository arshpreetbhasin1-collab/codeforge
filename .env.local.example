# CodeForge — Environment Variables
#
# Copy this file to `.env.local` and fill in real values. Never commit
# `.env.local` — it's gitignored via the blanket `.env*` rule in .gitignore.

# --- Supabase (Postgres + Auth) ---------------------------------------
# From your Supabase project's Settings > API page.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. Server-only — bypasses Row Level Security. Never expose
# to the browser. See lib/db/supabase-admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# --- App -----------------------------------------------------------------
# Used for building absolute URLs (e.g. password-reset email redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Auth: email verification (Prompt 7) ----------------------------------
# See lib/auth/config.ts. Server-only — never exposed to the client.
# false (default): signup -> authenticated session -> onboarding, no email
#   click required. Matches this deployment's Auth backend, which must
#   ALSO be set to auto-confirm (self-hosted GoTrue: GOTRUE_MAILER_AUTOCONFIRM=true;
#   Supabase Cloud: Authentication > Providers > Email > disable "Confirm email").
# true: signup -> verify-email -> onboarding, using the real flow built in
#   Prompt 5 (unchanged). Only turn this on once transactional email is
#   configured reliably, and flip the Auth backend's own setting back to
#   requiring confirmation at the same time — this flag alone does not
#   control GoTrue/Supabase's behavior, only which app-side flow to take.
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# --- AI provider (Prompt 5 wires this up) ---------------------------------
# Populate whichever provider lib/ai/provider.ts is configured to use.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Code execution (Prompt 3) --------------------------------------------
# C/C++/Java/Python execution — see lib/execution/providers/wandbox-provider.ts.
# The public instance (https://wandbox.org/api) needs no key and works with
# no configuration, but is shared, rate-limited, best-effort infrastructure.
# For production, self-host Wandbox (https://github.com/melpon/wandbox) or
# swap in another isolated provider (Judge0, Piston, ...) and point this at
# it — no other file needs to change.
# WANDBOX_API_URL=https://wandbox.org/api

# SQL execution — see services/execution/sql-sandbox.ts. MUST be a database
# dedicated to this sandbox, never the app's own Supabase database — every
# execution runs inside a transaction that is always rolled back, but the
# connecting role should additionally have zero privileges outside its own
# throwaway schemas as defense in depth. Required for SQL problems to work;
# without it, submitting a SQL solution fails with an explicit
# "not configured" error rather than silently doing nothing.
# SQL_SANDBOX_DATABASE_URL=postgres://user:password@host:5432/codeforge_sql_sandbox
